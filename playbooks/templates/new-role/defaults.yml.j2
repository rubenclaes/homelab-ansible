# De defaults dragen de uitleg van deze rol. Er is geen README per rol: wat
# een variabele betekent en waarom hij die waarde heeft, staat hier, waar je
# hem toch al aan het lezen bent.
#
# Alles met een `vault_`-tegenhanger hoort géén default te hebben. Een secret
# dat stilletjes op een lege string terugvalt geeft een rol die draait en
# niets doet; liever een rode run met een melding die zegt welk bestand
# ontbreekt. Zie roles/adguard/defaults/main.yml onderaan.

# Gepind, zodat een upgrade iets is wat je kiest. Bumpen betekent ook de
# checksum of de digest meenemen.
[[ svc_name ]]_version: "TODO"

[[ svc_name ]]_config: /etc/[[ svc_name ]]/[[ svc_name ]].conf
