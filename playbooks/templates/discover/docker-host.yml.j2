---
# Voorstel voor inventory/host_vars/{{ inventory_hostname }}.yml
# Gelezen van de host zelf op {{ '%Y-%m-%d' | strftime }}. Geen inventory:
# lees het na, snoei het, en zet wat blijft in het echte host_vars-bestand.
{% set projects = discover_projects.stdout | from_json %}
{% set containers = [] %}
{% for line in discover_containers.stdout_lines %}{% set _ = containers.append(line | from_json) %}{% endfor %}

# --- De stacks ------------------------------------------------------------
# `path` is relatief aan docker_stacks_root ({{ docker_stacks_root | default('/opt/containers/stacks') }}).
# Staat de compose-file daar niet onder, dan hoort hij eerst in de
# containers-repo voor deze regel klopt - de rol kan alleen uitrollen wat
# daarin staat.
docker_stacks_list:
{% for p in projects | sort(attribute='Name') %}
{% set cfg = p.ConfigFiles | default('') %}
{% set dir = cfg.split(',')[0] | dirname %}
{% set root = docker_stacks_root | default('/opt/containers/stacks') %}
  - { name: {{ p.Name }}, path: {{ dir[root | length + 1:] if dir.startswith(root) else dir }} }{{ '  # LET OP: staat buiten de stacks-map' if not dir.startswith(root) else '' }}
{% endfor %}
{% if projects | length == 0 %}
  []  # docker compose ls gaf niets terug: draaien de containers los, zonder compose?
{% endif %}

# --- Wat er nu luistert ---------------------------------------------------
# Eén regel per container met een gepubliceerde poort. Hoort er een route bij,
# zet hem in caddy_sites (inventory/host_vars/caddy/main.yml). Hoort er
# bewust géén route bij, zet de poort in docker_ports_without_route, anders
# meldt report.yml hem elke run als drift.
{% for c in containers | sort(attribute='Names') %}
{% if c.Ports | default('') | length > 0 %}
#   {{ '%-28s' | format(c.Names) }} {{ c.Ports }}
{% else %}
#   {{ '%-28s' | format(c.Names) }} (geen gepubliceerde poort)
{% endif %}
{% endfor %}

# --- Waar de rol zijn spullen zet -----------------------------------------
# Alleen nodig als deze host afwijkt van de defaults in
# roles/docker_stacks/defaults/main.yml.
# docker_stacks_owner: {{ ansible_facts['user_id'] | default('ruben') }}
# docker_stacks_root: {{ docker_stacks_root | default('/opt/containers/stacks') }}
