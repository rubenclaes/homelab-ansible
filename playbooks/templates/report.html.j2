<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Homelab report</title>
<style>
  :root { --bg: #f7f7f5; --fg: #1d1d1f; --muted: #6e6e73; --card: #fff; --line: #e5e5e5;
          --ok: #1a7f37; --warn: #9a6700; --bad: #cf222e; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #161618; --fg: #f2f2f2; --muted: #9a9aa0; --card: #1f1f22; --line: #333;
            --ok: #3fb950; --warn: #d29922; --bad: #f85149; }
  }
  body { font-family: -apple-system, system-ui, sans-serif; background: var(--bg); color: var(--fg);
         margin: 0; padding: 24px 16px; }
  main { max-width: 900px; margin: 0 auto; }
  h1 { margin: 0 0 4px; font-size: 1.6rem; }
  .sub { color: var(--muted); margin-bottom: 24px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px;
          margin-bottom: 16px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--muted); font-weight: 600; font-size: .8rem; text-transform: uppercase; }
  tr:last-child td { border-bottom: none; }
  .ok { color: var(--ok); } .warn { color: var(--warn); font-weight: 600; } .bad { color: var(--bad); font-weight: 700; }
  .muted { color: var(--muted); }
  /* Long enumerations (a Mac can be 50+ packages behind) must wrap
     rather than inherit the table's nowrap and scroll off sideways. */
  td.wrap { white-space: normal; min-width: 22rem; }

  /* Tabs without JavaScript. The radios sit immediately before the panels,
     so a sibling selector can reveal the panel whose radio is checked. They
     are hidden with opacity rather than display:none so they stay focusable
     and the tab bar can be driven from the keyboard. */
  input.tab { position: absolute; width: 0; height: 0; opacity: 0; }
  .tabbar { display: flex; gap: 4px; border-bottom: 1px solid var(--line); margin-bottom: 16px; }
  .tabbar label { padding: 8px 14px; margin-bottom: -1px; cursor: pointer; font-size: .9rem;
                  font-weight: 600; color: var(--muted); border-bottom: 2px solid transparent; }
  #tab-overzicht:checked ~ .tabbar label[for="tab-overzicht"],
  #tab-updates:checked ~ .tabbar label[for="tab-updates"] { color: var(--fg); border-bottom-color: var(--fg); }
  #tab-overzicht:focus-visible ~ .tabbar label[for="tab-overzicht"],
  #tab-updates:focus-visible ~ .tabbar label[for="tab-updates"] { outline: 2px solid var(--fg); outline-offset: -2px; }
  .panel { display: none; }
  #tab-overzicht:checked ~ #panel-overzicht,
  #tab-updates:checked ~ #panel-updates { display: block; }
  .pill { background: var(--line); border-radius: 999px; padding: 1px 7px; font-size: .75rem;
          margin-left: 5px; font-weight: 600; }
  .pill.bad { background: var(--bad); color: #fff; }
  /* A second line inside a card. `.sub` cannot serve here: it carries the
     24px gap it needs under the page title. */
  .note { color: var(--muted); font-size: .85rem; margin-top: 6px; }
</style>
</head>
<body>
<main>
{% set cert_end = report_cert.not_after | to_datetime('%Y%m%d%H%M%SZ') %}
{% set now_utc = now(utc=true).strftime('%Y%m%d%H%M%SZ') | to_datetime('%Y%m%d%H%M%SZ') %}
{% set cert_days = (cert_end - now_utc).days %}
  <h1>Homelab report</h1>
  <div class="sub">Generated {{ now().strftime('%A %d %B %Y, %H:%M') }}</div>

{# ---------------------------------------------------------------------------
   Everything the Updates tab shows, gathered once so the tab bar can carry a
   count before the panel is rendered.

   Three sources, one shape. apt rows carry the origin they came from, which
   is the only place the report can learn that an upgrade is a security fix;
   brew and softwareupdate offer no equivalent, so their rows are never
   marked. A host with report_row undefined was unreachable and is left out
   of both lists rather than counted as up to date.
   --------------------------------------------------------------------------- #}
{% set update_rows = [] %}
{% set update_clean = [] %}
{% set update_reboot = [] %}
{% for h in (groups['linux'] + groups['macs'] | default([])) | sort %}
{% set hv = hostvars[h] %}
{% if hv.report_row is defined %}
{% set host_rows = [] %}
{% for pkg in hv.report_packages | default([]) %}
{% set _ = host_rows.append({'host': h, 'source': 'apt', 'name': pkg.name,
                             'current': pkg.current, 'candidate': pkg.candidate,
                             'security': 'security' in (pkg.origin | lower)}) %}
{% endfor %}
{% for pkg in hv.report_brew_rows | default([]) %}
{% set _ = host_rows.append({'host': h, 'source': 'brew', 'name': pkg.name,
                             'current': pkg.current, 'candidate': pkg.candidate,
                             'security': false}) %}
{% endfor %}
{% for pkg in hv.report_swu_rows | default([]) %}
{% set _ = host_rows.append({'host': h, 'source': 'macOS', 'name': pkg.name,
                             'current': '', 'candidate': pkg.candidate,
                             'security': false}) %}
{% endfor %}
{% set _ = update_rows.extend(host_rows) %}
{% if not host_rows %}{% set _ = update_clean.append(h) %}{% endif %}
{% if hv.report_row.reboot | bool %}{% set _ = update_reboot.append(h) %}{% endif %}
{% endif %}
{% endfor %}
{% set update_security = update_rows | selectattr('security') | list %}

  <input class="tab" type="radio" name="tab" id="tab-overzicht" checked>
  <input class="tab" type="radio" name="tab" id="tab-updates">
  <div class="tabbar">
    <label for="tab-overzicht">Overzicht</label>
    <label for="tab-updates">Updates<span class="pill{{ ' bad' if update_security else '' }}">{{ update_rows | length }}</span></label>
  </div>

  <div class="panel" id="panel-overzicht">

  <div class="card">
    <strong>*.neodata.be certificate</strong>:
    <span class="{{ 'bad' if cert_days < 14 else 'warn' if cert_days < 30 else 'ok' }}">
      {{ cert_days }} days left
    </span>
    ({{ cert_end.strftime('%d %b %Y') }})
  </div>

  <div class="card">
    <table>
      <tr><th>Host</th><th>OS</th><th>Kernel</th><th>Uptime</th><th>Disk</th><th>Updates</th><th>Reboot</th></tr>
{% for h in (groups['linux'] + groups['macs'] | default([])) | sort %}
{% if hostvars[h].report_row is defined %}
{% set r = hostvars[h].report_row %}
      <tr>
        <td><strong>{{ r.host }}</strong></td>
        <td>{{ r.os }}</td>
        <td>{{ r.kernel }}</td>
        <td>{{ r.uptime_days }} d</td>
        <td class="{{ 'bad' if r.disk_used_pct | int >= 85 else 'warn' if r.disk_used_pct | int >= 70 else 'ok' }}">{{ r.disk_used_pct }}%</td>
        <td class="{{ 'warn' if r.pending | int > 0 else 'ok' }}">{{ r.pending }}</td>
        <td class="{{ 'bad' if r.reboot | bool else 'ok' }}">{{ 'yes' if r.reboot | bool else 'no' }}</td>
      </tr>
{% elif h in groups['macs'] | default([]) %}
      <tr><td><strong>{{ h }}</strong></td><td colspan="6" class="muted">niet gemeten</td></tr>
{% else %}
      <tr><td><strong>{{ h }}</strong></td><td colspan="6" class="bad">unreachable during this run</td></tr>
{% endif %}
{% endfor %}
    </table>
  </div>


  {% if hostvars['docker'].report_containers is defined %}
  <div class="card">
    <strong>Docker on docker</strong>
    <table>
      <tr><th>Stack</th><th>Running</th><th>Problems</th></tr>
{% for project, items in hostvars['docker'].report_containers | groupby('project') %}
{% set running = items | selectattr('state', 'equalto', 'running') | list %}
{% set problems = (items | rejectattr('state', 'equalto', 'running') | list)
                + (items | selectattr('status', 'search', 'unhealthy') | list) %}
      <tr>
        <td><strong>{{ project }}</strong></td>
        <td class="{{ 'ok' if running | length == items | length else 'warn' }}">{{ running | length }} / {{ items | length }}</td>
        <td class="{{ 'bad' if problems else 'ok' }}">{{ problems | map(attribute='name') | join(', ') if problems else 'none' }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}

{# ---------------------------------------------------------------------------
   Homebrew drift. The Updates column and the Updates tab both fold brew in
   with everything else; this card is what splits it back out, because brew is
   a second, independent package tree with its own upgrade gate in update.yml
   (allow_cask_upgrade) and its own reasons to be left behind.
   --------------------------------------------------------------------------- #}
{% set brew_macs = groups['macs'] | default([]) | sort | map('extract', hostvars)
                   | selectattr('report_mac', 'defined') | list %}
{% if brew_macs %}
  <div class="card">
    <strong>Homebrew-drift op de Macs</strong>
    <div class="sub">Verouderde formulae en casks</div>
    <table>
      <tr><th>Mac</th><th>Verouderd</th><th>Pakketten</th></tr>
{% for m in brew_macs %}
      <tr>
        <td><strong>{{ m.report_row.host }}</strong></td>
        <td class="{{ 'warn' if m.report_mac.brew_outdated | int > 0 else 'ok' }}">{{ m.report_mac.brew_outdated }}</td>
        <td class="wrap">{{ m.report_mac.brew_packages | join(', ') if m.report_mac.brew_packages else 'geen' }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}

{# ---------------------------------------------------------------------------
   Route drift: Caddy routes against what docker actually publishes.

   The smoke test cannot see half of this. It requests every route in
   caddy_sites, so it catches a route whose backend is down - but a container
   publishing a port nobody proxies is invisible to it, because there is no
   route to request.
   --------------------------------------------------------------------------- #}
{% if hostvars['docker'].report_published is defined %}
{% set published = hostvars['docker'].report_published %}
{% set ignored = hostvars['docker'].docker_ports_without_route | default([]) | map(attribute='port') | list %}
{% set docker_routes = hostvars['caddy'].caddy_sites | selectattr('host', 'defined')
                       | selectattr('host', 'eq', 'docker') | list %}
{% set live_ports = published | map(attribute='port') | unique | list %}
{% set dead_routes = docker_routes | rejectattr('port', 'in', live_ports) | list %}
{% set unrouted = published | rejectattr('port', 'in', docker_routes | map(attribute='port') | list)
                  | rejectattr('port', 'in', ignored) | list %}
  <div class="card">
    <strong>Route-drift op docker</strong>
    <div class="sub">Caddy-routes tegenover wat er draait</div>
    <table>
      <tr><th>Soort</th><th>Naam</th><th>Poort</th><th>Betekenis</th></tr>
{% for r in dead_routes | sort(attribute='name') %}
      <tr>
        <td class="bad">route zonder container</td>
        <td><strong>{{ r.name }}</strong></td>
        <td>{{ r.port }}</td>
        <td>{{ r.name }}.{{ hostvars['caddy'].caddy_domain }} wijst nergens heen</td>
      </tr>
{% endfor %}
{% for u in unrouted | sort(attribute='port') %}
      <tr>
        <td class="warn">container zonder route</td>
        <td><strong>{{ u.name }}</strong></td>
        <td>{{ u.port }}</td>
        <td>alleen bereikbaar als {{ hostvars['docker'].ansible_host }}:{{ u.port }}</td>
      </tr>
{% endfor %}
{% if not dead_routes and not unrouted %}
      <tr><td class="ok" colspan="4">routes en containers lopen gelijk</td></tr>
{% endif %}
    </table>
  </div>

{% set managed = hostvars['docker'].docker_stacks_list | map(attribute='name') | list %}
{% set unmanaged = published | map(attribute='project') | unique
                   | reject('in', managed) | reject('eq', '(none)') | list %}
{% if unmanaged %}
  <div class="card">
    <strong>Stacks buiten Ansible</strong>
    <div class="sub">draaien op docker maar staan niet in docker_stacks_list</div>
    <table>
      <tr><th>Project</th><th>Containers</th></tr>
{% for proj in unmanaged | sort %}
      <tr>
        <td class="warn"><strong>{{ proj }}</strong></td>
        <td>{{ published | selectattr('project', 'eq', proj) | map(attribute='name') | unique | join(', ') }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}
{% endif %}

{% set pve = hostvars['pve01'] %}
{% if pve.report_pools is defined %}
  <div class="card">
    <strong>ZFS pools on pve01</strong>
    <table>
      <tr><th>Pool</th><th>Size</th><th>Used</th><th>Free</th><th>Usage</th><th>Health</th></tr>
{% for p in pve.report_pools %}
{% set cap = p.cap | replace('%', '') | int %}
      <tr>
        <td><strong>{{ p.name }}</strong></td>
        <td>{{ p.size }}</td><td>{{ p.alloc }}</td><td>{{ p.free }}</td>
        <td class="{{ 'bad' if cap >= 85 else 'warn' if cap >= 70 else 'ok' }}">{{ p.cap }}</td>
        <td class="{{ 'ok' if p.health == 'ONLINE' else 'bad' }}">{{ p.health }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}

{% if pve.report_disks is defined %}
  <div class="card">
    <strong>Disks on pve01 (SMART)</strong>
    <table>
      <tr><th>Device</th><th>Model</th><th>Health</th><th>Temp</th></tr>
{% for d in pve.report_disks %}
      <tr>
        <td><strong>{{ d.device }}</strong></td>
        <td>{{ d.model }}</td>
        <td class="{{ 'ok' if d.passed else 'bad' }}">{{ 'PASSED' if d.passed else 'FAILED / unknown' }}</td>
        <td class="{{ 'warn' if (d.temp is number and d.temp >= 55) else '' }}">{{ d.temp }}{{ ' °C' if d.temp is number else '' }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}

{% set backup_map = report_backups.json.data | items2dict(key_name='backup-id', value_name='last-backup') %}
  <div class="card">
    <strong>Backups (PBS, datastore store1)</strong>
    <table>
      <tr><th>ID</th><th>Guest</th><th>Type</th><th>Last backup</th><th>Age</th></tr>
{% for g in report_guests.proxmox_vms | sort(attribute='vmid') %}
{% set last = backup_map[g.vmid | string] | default(none) %}
      <tr>
        <td>{{ g.vmid }}</td>
        <td><strong>{{ g.name }}</strong></td>
        <td>{{ g.type }}</td>
{% if last is none %}
        <td class="bad" colspan="2">never backed up</td>
{% else %}
{% set age_h = ((now().timestamp() - last) / 3600) | round(0) | int %}
        <td>{{ '%Y-%m-%d %H:%M' | strftime(last) }}</td>
        <td class="{{ 'bad' if age_h > 48 else 'warn' if age_h > 26 else 'ok' }}">{{ age_h }} h</td>
{% endif %}
      </tr>
{% endfor %}
    </table>
  </div>

  </div>

  <div class="panel" id="panel-updates">

  <div class="card">
    <strong>{{ update_rows | length }} openstaande updates</strong>
    op {{ update_rows | map(attribute='host') | unique | list | length }} van
    {{ (update_rows | map(attribute='host') | unique | list | length) + (update_clean | length) }} gemeten hosts,
    waarvan <span class="{{ 'bad' if update_security else 'ok' }}">{{ update_security | length }} security</span>.
{% if update_reboot %}
    <div class="note">Herstart nodig: <span class="bad">{{ update_reboot | join(', ') }}</span> -
      <code>ansible-playbook playbooks/update.yml -e allow_reboot=true</code></div>
{% endif %}
{% if update_clean %}
    <div class="note">Niets open bij: {{ update_clean | join(', ') }}</div>
{% endif %}
  </div>

{% if update_rows %}
  <div class="card">
    <table>
      <tr><th>Host</th><th>Pakket</th><th>Nu</th><th>Nieuw</th><th>Bron</th></tr>
{# Three stable sorts, applied least significant first: host groups the table,
   security floats to the top of each host, and the rest is alphabetical. #}
{% for u in update_rows | sort(attribute='name') | sort(attribute='security', reverse=true) | sort(attribute='host') %}
      <tr>
        <td><strong>{{ u.host }}</strong></td>
        <td>{{ u.name }}</td>
        <td class="muted">{{ u.current or '-' }}</td>
        <td>{{ u.candidate }}</td>
        <td class="{{ 'warn' if u.security else 'muted' }}">{{ 'security' if u.security else u.source }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% else %}
  <div class="card"><span class="ok">Alles is bij.</span></div>
{% endif %}

  </div>

</main>
</body>
</html>