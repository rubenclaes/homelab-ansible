<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Homelab report</title>
<style>
  :root { --bg: #f7f7f5; --fg: #1d1d1f; --muted: #6e6e73; --card: #fff; --line: #e5e5e5;
          --ok: #1a7f37; --warn: #9a6700; --bad: #cf222e; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #161618; --fg: #f2f2f2; --muted: #9a9aa0; --card: #1f1f22; --line: #333;
            --ok: #3fb950; --warn: #d29922; --bad: #f85149; }
  }
  body { font-family: -apple-system, system-ui, sans-serif; background: var(--bg); color: var(--fg);
         margin: 0; padding: 24px 16px; }
  main { max-width: 900px; margin: 0 auto; }
  h1 { margin: 0 0 4px; font-size: 1.6rem; }
  .sub { color: var(--muted); margin-bottom: 24px; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 16px;
          margin-bottom: 16px; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--muted); font-weight: 600; font-size: .8rem; text-transform: uppercase; }
  tr:last-child td { border-bottom: none; }
  .ok { color: var(--ok); } .warn { color: var(--warn); font-weight: 600; } .bad { color: var(--bad); font-weight: 700; }
</style>
</head>
<body>
<main>
{% set cert_end = report_cert.not_after | to_datetime('%Y%m%d%H%M%SZ') %}
{% set now_utc = now(utc=true).strftime('%Y%m%d%H%M%SZ') | to_datetime('%Y%m%d%H%M%SZ') %}
{% set cert_days = (cert_end - now_utc).days %}
  <h1>Homelab report</h1>
  <div class="sub">Generated {{ now().strftime('%A %d %B %Y, %H:%M') }}</div>

  <div class="card">
    <strong>*.neodata.be certificate</strong>:
    <span class="{{ 'bad' if cert_days < 14 else 'warn' if cert_days < 30 else 'ok' }}">
      {{ cert_days }} days left
    </span>
    ({{ cert_end.strftime('%d %b %Y') }})
  </div>

  <div class="card">
    <table>
      <tr><th>Host</th><th>OS</th><th>Kernel</th><th>Uptime</th><th>Disk</th><th>Updates</th><th>Reboot</th></tr>
{% for h in groups['linux'] | sort %}
{% if hostvars[h].report_row is defined %}
{% set r = hostvars[h].report_row %}
      <tr>
        <td><strong>{{ r.host }}</strong></td>
        <td>{{ r.os }}</td>
        <td>{{ r.kernel }}</td>
        <td>{{ r.uptime_days }} d</td>
        <td class="{{ 'bad' if r.disk_used_pct | int >= 85 else 'warn' if r.disk_used_pct | int >= 70 else 'ok' }}">{{ r.disk_used_pct }}%</td>
        <td class="{{ 'warn' if r.pending | int > 0 else 'ok' }}">{{ r.pending }}</td>
        <td class="{{ 'bad' if r.reboot | bool else 'ok' }}">{{ 'yes' if r.reboot | bool else 'no' }}</td>
      </tr>
{% else %}
      <tr><td><strong>{{ h }}</strong></td><td colspan="6" class="bad">unreachable during this run</td></tr>
{% endif %}
{% endfor %}
    </table>
  </div>


  {% if hostvars['docker'].report_containers is defined %}
  <div class="card">
    <strong>Docker on docker</strong>
    <table>
      <tr><th>Stack</th><th>Running</th><th>Problems</th></tr>
{% for project, items in hostvars['docker'].report_containers | groupby('project') %}
{% set running = items | selectattr('state', 'equalto', 'running') | list %}
{% set problems = (items | rejectattr('state', 'equalto', 'running') | list)
                + (items | selectattr('status', 'search', 'unhealthy') | list) %}
      <tr>
        <td><strong>{{ project }}</strong></td>
        <td class="{{ 'ok' if running | length == items | length else 'warn' }}">{{ running | length }} / {{ items | length }}</td>
        <td class="{{ 'bad' if problems else 'ok' }}">{{ problems | map(attribute='name') | join(', ') if problems else 'none' }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}

{# ---------------------------------------------------------------------------
   Route drift: Caddy routes against what docker actually publishes.

   The smoke test cannot see half of this. It requests every route in
   caddy_sites, so it catches a route whose backend is down - but a container
   publishing a port nobody proxies is invisible to it, because there is no
   route to request.
   --------------------------------------------------------------------------- #}
{% if hostvars['docker'].report_published is defined %}
{% set published = hostvars['docker'].report_published %}
{% set ignored = hostvars['docker'].docker_ports_without_route | default([]) | map(attribute='port') | list %}
{% set docker_routes = hostvars['caddy'].caddy_sites | selectattr('host', 'defined')
                       | selectattr('host', 'eq', 'docker') | list %}
{% set live_ports = published | map(attribute='port') | unique | list %}
{% set dead_routes = docker_routes | rejectattr('port', 'in', live_ports) | list %}
{% set unrouted = published | rejectattr('port', 'in', docker_routes | map(attribute='port') | list)
                  | rejectattr('port', 'in', ignored) | list %}
  <div class="card">
    <strong>Route-drift op docker</strong>
    <div class="sub">Caddy-routes tegenover wat er draait</div>
    <table>
      <tr><th>Soort</th><th>Naam</th><th>Poort</th><th>Betekenis</th></tr>
{% for r in dead_routes | sort(attribute='name') %}
      <tr>
        <td class="bad">route zonder container</td>
        <td><strong>{{ r.name }}</strong></td>
        <td>{{ r.port }}</td>
        <td>{{ r.name }}.{{ hostvars['caddy'].caddy_domain }} wijst nergens heen</td>
      </tr>
{% endfor %}
{% for u in unrouted | sort(attribute='port') %}
      <tr>
        <td class="warn">container zonder route</td>
        <td><strong>{{ u.name }}</strong></td>
        <td>{{ u.port }}</td>
        <td>alleen bereikbaar als {{ hostvars['docker'].ansible_host }}:{{ u.port }}</td>
      </tr>
{% endfor %}
{% if not dead_routes and not unrouted %}
      <tr><td class="ok" colspan="4">routes en containers lopen gelijk</td></tr>
{% endif %}
    </table>
  </div>

{% set managed = hostvars['docker'].docker_stacks_list | map(attribute='name') | list %}
{% set unmanaged = published | map(attribute='project') | unique
                   | reject('in', managed) | reject('eq', '(none)') | list %}
{% if unmanaged %}
  <div class="card">
    <strong>Stacks buiten Ansible</strong>
    <div class="sub">draaien op docker maar staan niet in docker_stacks_list</div>
    <table>
      <tr><th>Project</th><th>Containers</th></tr>
{% for proj in unmanaged | sort %}
      <tr>
        <td class="warn"><strong>{{ proj }}</strong></td>
        <td>{{ published | selectattr('project', 'eq', proj) | map(attribute='name') | unique | join(', ') }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}
{% endif %}

{% set pve = hostvars['pve01'] %}
{% if pve.report_pools is defined %}
  <div class="card">
    <strong>ZFS pools on pve01</strong>
    <table>
      <tr><th>Pool</th><th>Size</th><th>Used</th><th>Free</th><th>Usage</th><th>Health</th></tr>
{% for p in pve.report_pools %}
{% set cap = p.cap | replace('%', '') | int %}
      <tr>
        <td><strong>{{ p.name }}</strong></td>
        <td>{{ p.size }}</td><td>{{ p.alloc }}</td><td>{{ p.free }}</td>
        <td class="{{ 'bad' if cap >= 85 else 'warn' if cap >= 70 else 'ok' }}">{{ p.cap }}</td>
        <td class="{{ 'ok' if p.health == 'ONLINE' else 'bad' }}">{{ p.health }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}

{% if pve.report_disks is defined %}
  <div class="card">
    <strong>Disks on pve01 (SMART)</strong>
    <table>
      <tr><th>Device</th><th>Model</th><th>Health</th><th>Temp</th></tr>
{% for d in pve.report_disks %}
      <tr>
        <td><strong>{{ d.device }}</strong></td>
        <td>{{ d.model }}</td>
        <td class="{{ 'ok' if d.passed else 'bad' }}">{{ 'PASSED' if d.passed else 'FAILED / unknown' }}</td>
        <td class="{{ 'warn' if (d.temp is number and d.temp >= 55) else '' }}">{{ d.temp }}{{ ' °C' if d.temp is number else '' }}</td>
      </tr>
{% endfor %}
    </table>
  </div>
{% endif %}

{% set backup_map = report_backups.json.data | items2dict(key_name='backup-id', value_name='last-backup') %}
  <div class="card">
    <strong>Backups (PBS, datastore store1)</strong>
    <table>
      <tr><th>ID</th><th>Guest</th><th>Type</th><th>Last backup</th><th>Age</th></tr>
{% for g in report_guests.proxmox_vms | sort(attribute='vmid') %}
{% set last = backup_map[g.vmid | string] | default(none) %}
      <tr>
        <td>{{ g.vmid }}</td>
        <td><strong>{{ g.name }}</strong></td>
        <td>{{ g.type }}</td>
{% if last is none %}
        <td class="bad" colspan="2">never backed up</td>
{% else %}
{% set age_h = ((now().timestamp() - last) / 3600) | round(0) | int %}
        <td>{{ '%Y-%m-%d %H:%M' | strftime(last) }}</td>
        <td class="{{ 'bad' if age_h > 48 else 'warn' if age_h > 26 else 'ok' }}">{{ age_h }} h</td>
{% endif %}
      </tr>
{% endfor %}
    </table>
  </div>

</main>
</body>
</html>