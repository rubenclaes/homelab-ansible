| {{ l.vmid }} | **{{ l.hostname }}** | {{ l.cores }} core{{ 's' if l.cores != 1 }} | {{ (l.memory / 1024) | round(1) ~ ' GB' if l.memory >= 1024 else l.memory ~ ' MB' }} | {{ l.disk.size }} GB on `{{ l.disk.storage }}` | `{{ l.ip }}` |
{% endfor %}

