#!/usr/bin/env bash
# Fails if any file that must be encrypted is sitting in the repo as plaintext.
#
# Run locally with `bin/check-vaulted`, and in CI on every push. This catches
# the one mistake that is expensive to undo: committing a secret, which stays
# in git history even after you delete it.
#
# With --staged it reads the *staged* blob for each file instead of the file on
# disk. That distinction matters in a pre-commit hook: `git add` snapshots
# content, so a file can be encrypted on disk while a plaintext version sits in
# the index waiting to be committed. Checking the working tree would miss it.
set -euo pipefail

cd "$(dirname "$0")/.."

staged=0
[[ "${1:-}" == "--staged" ]] && staged=1

# Every path here must begin with the $ANSIBLE_VAULT header.
patterns=(
	'files/env/*.env'
	'inventory/group_vars/*/vault.yml'
	'inventory/host_vars/*/vault.yml'
	'roles/semaphore/files/config.json'
)

failed=0
checked=0

# Reads the first bytes of a path, from the index or from disk.
head_of() {
	if [[ $staged -eq 1 ]]; then
		git show ":$1" 2>/dev/null | head -c 15
	else
		head -c 15 "$1"
	fi
}

for pattern in "${patterns[@]}"; do
	for file in $pattern; do
		if [[ $staged -eq 1 ]]; then
			# Only consider paths that are actually in the index.
			git ls-files --error-unmatch -- "$file" >/dev/null 2>&1 || continue
		else
			[[ -f "$file" ]] || continue
		fi
		checked=$((checked + 1))
		if head_of "$file" | grep -q '^\$ANSIBLE_VAULT'; then
			echo "  encrypted  $file"
		else
			echo "  PLAINTEXT  $file" >&2
			failed=$((failed + 1))
		fi
	done
done

if [[ $checked -eq 0 ]]; then
	echo "check-vaulted: matched no files at all - did the layout change?" >&2
	exit 1
fi

if [[ $failed -gt 0 ]]; then
	echo >&2
	echo "check-vaulted: $failed file(s) are NOT encrypted." >&2
	echo "Encrypt with: ansible-vault encrypt <file>" >&2
	exit 1
fi

echo "check-vaulted: all $checked sensitive file(s) encrypted."
