{
	# Global options (moet als allereerste)
	email ruben.claes@neodata.be

	# Runtime logs van Caddy zelf
	log {
		output file /var/log/caddy/runtime.log {
			roll_at 00:00
			roll_size 100MiB
			roll_keep 14
			roll_keep_for 336h
			roll_local_time
		}
		format json
		level INFO
	}

	# Als je ooit Cloudflare "proxied" (orange cloud) gebruikt voor sommige hosts:
	# dan wil je client IP's correct én veilig verwerken.
	# servers {
	# 	trusted_proxies static private_ranges
	# }
	# (Of specifieker: Cloudflare IP ranges i.p.v. private_ranges)

	# Handig voor Prometheus
	metrics {
		per_host
	}
}

# -----------------------
# Wildcard trigger + DNS-01
# -----------------------
# Eén wildcard-cert *.neodata.be dekt al je subdomeinen (Caddy 2.10+ gebruikt
# 'm automatisch voor de blokken hieronder). De DNS-01 config staat hier omdat
# 'resolvers' enkel in een tls-blok mag. Vangt ongedefinieerde subdomeinen af.
# Raakt apex/www (DANE) NIET aan.
*.neodata.be {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	abort
}

# -----------------------
# Default HTTP site (port 80)
# -----------------------
:80 {
	root * /usr/share/caddy
	file_server
}

# -----------------------
# Common snippets
# -----------------------
(common_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(proxy_defaults) {
	import common_headers
	encode

	log {
		output file /var/log/caddy/access.log {
			roll_at 00:00
			roll_size 250MiB
			roll_keep 14
			roll_keep_for 336h
			roll_local_time
		}
		format json
		level INFO
	}
}

(tinyauth_forwarder) {
	forward_auth 192.168.0.26:3000 {
		uri /api/auth/caddy
	}
}

# Gebruik dit alleen tijdelijk als een upstream-cert echt niet proper is.
(https_upstream_insecure) {
	transport http {
		tls_insecure_skip_verify
	}
}

# -----------------------
# Special cases
# -----------------------
ca.neodata.be {
	import common_headers

	# puur file download hosten
	root * /var/www/caddy-ca
	file_server

	# force download in de browser
	header Content-Disposition "attachment; filename=caddy-local-root.crt"
	header Content-Type "application/x-x509-ca-cert"
}

portainer.neodata.be {
	import proxy_defaults
	reverse_proxy https://192.168.0.15:9443 {
		import https_upstream_insecure
		header_up Host {host}
	}
}

