// De toegangsregels van de tailnet (brill-atlas.ts.net).
//
// DIT IS DE BRON. OpenTofu zet dit bestand in Tailscale:
//
//     bin/tofu tailscale plan     # wat zou er veranderen
//     bin/tofu tailscale apply    # doen
//
// In de console kan je de regels niet meer aanpassen ("edits beperken").
// Tailscale draait bij elke apply de `tests` onderaan, en weigert als er een
// faalt. Zie het runbook "Tailscale-regels aanpassen".
//
// Waarom deze regels: ct 108 biedt het hele thuisnetwerk aan (192.168.0.0/24)
// en die route is goedgekeurd. Met de standaardregel "alles mag alles" kreeg
// iedereen die je via NeoGate op de tailnet zet, dus ook pve01, Proxmox, SSH en
// de Mac mini. Nu mag jij alles, en de anderen alleen wat ze nodig hebben: de
// diensten, die allemaal via Caddy lopen, en DNS om hun namen op te lossen.
//
// De Mac mini en adguard staan hieronder als plaatshouder, niet als adres.
// OpenTofu vult hun 100.x-adres in uit de toestellen zelf
// (tofu/tailscale/policy.tf): meldt een van beide zich opnieuw aan, dan volgt
// de policy bij de volgende apply vanzelf. Daarom is dit bestand op zichzelf
// geen geldige HuJSON; plak het niet zo in de console.
{
	"tagOwners": {
		"tag:ci":      [],
		"tag:homelab": ["rubes.claes@gmail.com"],
		"tag:work":    ["rubes.claes@gmail.com"],
	},

	// Namen voor adressen, zodat de regels leesbaar blijven.
	"hosts": {
		"caddy":    "192.168.0.25",
		"mac-mini": "${mac_mini}",
	},

	// Een poort zonder protocol ("443") is TCP én UDP: UDP 443 is HTTP/3 bij Caddy.
	"grants": [
		// Jij: alles, ook het hele thuisnetwerk via de subnet-route van ct 108.
		{
			"src": ["rubes.claes@gmail.com"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// Iedereen op de tailnet: de diensten, en die gaan allemaal via Caddy.
		{
			"src": ["autogroup:member"],
			"dst": ["caddy"],
			"ip":  ["80", "443"],
		},
		// En DNS bij adguard, anders lost *.neodata.be niet op. tag:homelab staat
		// erbij voor ct 108 en wat met tailscale-key.yml binnenkomt: een getagd
		// toestel is geen member. tag:work niet: die heeft zijn eigen DNS.
		{
			"src": ["autogroup:member", "tag:homelab"],
			"dst": ["tag:homelab"],
			"ip":  ["53"],
		},
		// Plex rechtstreeks op de Mac mini, zonder Caddy of subnet-router.
		// Voor de Tailscale-boxen bij de TV's van de familie.
		{
			"src": ["autogroup:member"],
			"dst": ["mac-mini"],
			"ip":  ["32400"],
		},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],

	// Tailscale weigert op te slaan als een van deze niet klopt.
	"tests": [
		{
			"src":  "tag:work",
			"deny": ["192.168.0.10:8006", "192.168.0.10:22", "${adguard}:53"],
		},
		{
			"src":    "rubes.claes@gmail.com",
			"accept": ["192.168.0.10:8006", "192.168.0.25:443", "${adguard}:53", "tag:work:22"],
		},
		{
			"src":    "maarten.claes95@gmail.com",
			"accept": ["${mac_mini}:32400", "192.168.0.25:443", "${adguard}:53"],
			// SSH op Caddy, de UniFi-gateway, de AdGuard-UI op het LAN, SSH op de servers.
			"deny":   ["${mac_mini}:22", "192.168.0.10:8006", "192.168.0.25:22", "192.168.0.1:443", "192.168.0.29:80", "tag:homelab:22"],
		},
		// ct 108 en de sleutel-toestellen: DNS, en verder niets.
		{
			"src":    "tag:homelab",
			"accept": ["${adguard}:53"],
			"deny":   ["192.168.0.10:8006", "192.168.0.25:443", "${mac_mini}:32400", "rubes.claes@gmail.com:22"],
		},
	],
}
