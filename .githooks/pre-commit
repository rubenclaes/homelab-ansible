#!/usr/bin/env bash
# Pre-commit guard. Enable once per clone with:
#
#     git config core.hooksPath .githooks
#
# Why this exists rather than relying on CI: the CI check runs after a push,
# by which point a leaked secret is already in GitHub's history and needs a
# rotation, not a revert. This is the gate; CI is the backstop.
#
# Bypass in a genuine emergency with `git commit --no-verify`.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

fail=0

# 1. Nothing sensitive may be committed as plaintext. Checks the staged blob,
#    not the working tree - `git add` snapshots content, so the two can differ.
out="$(mktemp)"
trap 'rm -f "$out"' EXIT
if ! bin/check-vaulted --staged > "$out" 2>&1; then
	echo "pre-commit: a file that must be encrypted is staged as plaintext." >&2
	grep 'PLAINTEXT' "$out" >&2 || true
	echo >&2
	echo "  Encrypt it:  ansible-vault encrypt <file> && git add <file>" >&2
	fail=1
fi

# 2. The collection cache is a build artefact and must never be committed,
#    even with `git add -f`.
if git diff --cached --name-only | grep -q '^\.ansible/'; then
	echo "pre-commit: .ansible/ is a regenerable collection cache; do not commit it." >&2
	echo "  Unstage it:  git rm -r --cached .ansible" >&2
	fail=1
fi

# 3. OpenTofu: opmaak en geldigheid, alleen voor een project waar iets van
#    gestaged is. Zonder backend (-backend=false), dus zonder R2 of geheimen;
#    de passphrase is een dummy, want validate leest geen state.
#
#    In een eigen, tijdelijke TF_DATA_DIR: de echte .terraform/ kent de
#    R2-backend al, en dan wil ook `init -backend=false` R2 bereiken. De
#    plugin-cache zorgt dat de provider niet elke commit opnieuw binnenkomt.
tofu_dirs="$(git diff --cached --name-only -- 'tofu/*/*' | cut -d/ -f1-2 | sort -u)"
if [[ -n "$tofu_dirs" ]] && ! command -v tofu >/dev/null; then
	echo "pre-commit: tofu is niet geïnstalleerd. Installeer: brew install opentofu" >&2
	echo "  (of: ansible-playbook playbooks/site.yml --limit mbp --tags macos)" >&2
	exit 1
fi
tofu_data="$(mktemp -d)"
trap 'rm -f "$out"; rm -rf "$tofu_data"' EXIT
mkdir -p "$HOME/.terraform.d/plugin-cache"
for d in $tofu_dirs; do
	[[ -d "$d" ]] || continue
	if ! tofu fmt -check "$d" >/dev/null; then
		echo "pre-commit: $d is niet opgemaakt. Draai: tofu fmt $d" >&2
		fail=1
	fi
	export TF_DATA_DIR="$tofu_data/${d//\//_}"
	export TF_PLUGIN_CACHE_DIR="$HOME/.terraform.d/plugin-cache"
	if ! TF_VAR_state_passphrase=pre-commit-validate-only \
		tofu -chdir="$d" init -backend=false -input=false >/dev/null 2>&1 ||
		! TF_VAR_state_passphrase=pre-commit-validate-only \
		tofu -chdir="$d" validate -no-color >/dev/null; then
		echo "pre-commit: $d is niet geldig. Draai: tofu -chdir=$d validate" >&2
		fail=1
	fi
done

exit $fail
