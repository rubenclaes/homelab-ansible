# Managed by Ansible - edit caddy_sites in inventory/host_vars/caddy/main.yml, not this file
{
	email {{ caddy_email }}

	log {
		output file /var/log/caddy/runtime.log {
			roll_at 00:00
			roll_size 100MiB
			roll_keep 14
			roll_keep_for 336h
			roll_local_time
			mode {{ caddy_log_mode }}
		}
		format json
		level INFO
	}

	metrics {
		per_host
	}
}

# Wildcard certificate via Cloudflare DNS-01; catches undefined subdomains
*.{{ caddy_domain }} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	abort
}

:80 {
	root * /usr/share/caddy
	file_server
}

# Read-only window on the admin API for NeoGate's Caddy plugin: it reads the
# site list (host -> upstream) to give its app tiles their public address.
# Only GET, only the routes path, only from caddy_neogate_host
# (plus caddy_config_readers, e.g. a dev machine).
# Never expose :2019 itself - it can rewrite this config - and not the rest of
# /config/ either. Skipped when that host has no address (stopped).
{% if caddy_neogate_host and hostvars[caddy_neogate_host]['ansible_host'] is defined %}
:2020 {
	@neogate {
		remote_ip {{ ([hostvars[caddy_neogate_host]['ansible_host']] + (caddy_config_readers | default([]))) | join(' ') }}
		method GET
		path /config/apps/http/servers*
	}
	handle @neogate {
		reverse_proxy localhost:2019 {
			header_up Host localhost:2019
		}
	}
	respond 403
}
{% endif %}

# -----------------------
# Snippets
# -----------------------
(common_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(proxy_defaults) {
	import common_headers
	encode

	log {
		output file /var/log/caddy/access.log {
			roll_at 00:00
			roll_size 250MiB
			roll_keep 14
			roll_keep_for 336h
			roll_local_time
			mode {{ caddy_log_mode }}
		}
		format json
		level INFO
	}
}

(https_upstream_insecure) {
	transport http {
		tls_insecure_skip_verify
	}
}
{% if caddy_forward_auth | default(false) %}

# Forward-auth: ask oauth2-proxy (roles/oauth2_proxy, on this container)
# whether the visitor is signed in via Pocket ID and in group {args[0]}.
# Not signed in: off to auth.{{ caddy_domain }}, and back here afterwards.
# Signed in but in the wrong group: oauth2-proxy answers 403, and so does this.
(auth) {
	forward_auth {{ caddy_forward_auth_upstream }} {
		uri /oauth2/auth?allowed_groups={args[0]}
		header_up X-Real-IP {remote_host}
		copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups
		@unauthorized status 401
		handle_response @unauthorized {
			redir https://auth.{{ caddy_domain }}/oauth2/start?rd={scheme}://{host}{uri} 302
		}
	}
}
{% endif %}

# -----------------------
# Special sites
# -----------------------
ca.{{ caddy_domain }} {
	import common_headers
	root * /var/www/caddy-ca
	file_server
	header Content-Disposition "attachment; filename=caddy-local-root.crt"
	header Content-Type "application/x-x509-ca-cert"
}

metrics.{{ caddy_domain }} {
	@lan client_ip private_ranges
	handle @lan {
		metrics
	}
	respond "Forbidden" 403
}

report.{{ caddy_domain }} {
	import common_headers
	@internal client_ip private_ranges 100.64.0.0/10
	handle @internal {
		root * {{ report_publish_dir }}
		file_server
	}
	respond "Forbidden" 403
}

docs.{{ caddy_domain }} {
	import common_headers
	@internal client_ip private_ranges 100.64.0.0/10
	handle @internal {
		root * /var/www/homelab-docs
		file_server
	}
	respond "Forbidden" 403
	# file_server geeft zelf een lege 404. Toon die van de site (app/not-found.jsx).
	handle_errors 404 {
		root * /var/www/homelab-docs
		rewrite * /404.html
		file_server
	}
}

{% if caddy_forward_auth | default(false) %}
# Where people sign in for the sites behind forward_auth. oauth2-proxy sets a
# cookie for .{{ caddy_domain }} here, so one sign-in counts for all of them.
auth.{{ caddy_domain }} {
	import proxy_defaults
	reverse_proxy {{ caddy_forward_auth_upstream }} {
		header_up X-Real-IP {remote_host}
	}
}

{% endif %}
# -----------------------
# Sites (generated from caddy_sites)
# -----------------------
{% macro proxy(site, upstream, depth) -%}
{% set t = '\t' * depth -%}
{% if site.https | default(false) or site.host_header | default(false) or site.forwarded | default(false) -%}
{{ t }}reverse_proxy {{ 'https://' if site.https | default(false) else '' }}{{ upstream }} {
{% if site.https | default(false) %}
{{ t }}	import https_upstream_insecure
{% endif %}
{{ t }}	header_up Host {host}
{% if site.forwarded | default(false) %}
{{ t }}	header_up X-Real-IP {remote_host}
{{ t }}	header_up X-Forwarded-For {remote_host}
{{ t }}	header_up X-Forwarded-Proto {scheme}
{% endif %}
{{ t }}}
{%- else -%}
{{ t }}reverse_proxy {{ upstream }}
{%- endif %}
{%- endmacro %}
{% for site in caddy_sites %}
{# Upstream is derived from the inventory host's ansible_host, so an IP change
   is made in one place. `upstream:` on the site overrides it for anything that
   is not an inventory host, or whose runtime address can be missing.
   An if, not `| default(...)`: default's argument is evaluated anyway, so a
   host without ansible_host (a stopped container) broke every site. #}
{% if site.upstream is defined %}
{% set upstream = site.upstream %}
{% else %}
{% set upstream = hostvars[site.host]['ansible_host'] ~ ':' ~ site.port %}
{% endif %}
{{ site.name }}.{{ caddy_domain }} {
	import proxy_defaults
{% if site.auth is defined and caddy_forward_auth | default(false) %}
{# Paths in auth_skip bypass the login: an app's own API with its own key,
   used by other apps (NeoGate talks to Sonarr and Radarr this way). #}
{% if site.auth_skip is defined %}
	@auth_skip path {{ site.auth_skip | join(' ') }}
	handle @auth_skip {
{{ proxy(site, upstream, 2) }}
	}
{% endif %}
	handle {
		import auth {{ site.auth }}
{{ proxy(site, upstream, 2) }}
	}
{% else %}
{{ proxy(site, upstream, 1) }}
{% endif %}
}

{% endfor %}