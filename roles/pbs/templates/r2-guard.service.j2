# {{ ansible_managed }}
[Unit]
Description=r2-guard: check Cloudflare R2, dan de sync naar R2
Wants=network-online.target
After=network-online.target proxmox-backup-proxy.service

[Service]
Type=oneshot
# De sync zelf draait binnen deze service en kan uren duren.
TimeoutStartSec=infinity
# Exit 2 = bewust gestopt of stilgelegd; geen fout van de service.
SuccessExitStatus=2
ExecStart=/usr/local/sbin/r2-guard
