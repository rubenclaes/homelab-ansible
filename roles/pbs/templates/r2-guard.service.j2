# {{ ansible_managed }}
[Unit]
Description=r2-guard: houdt Cloudflare R2 binnen de gratis laag
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Exit 2 = gestopt of stilgelegd; dat is een bewuste uitkomst, geen fout.
SuccessExitStatus=2
ExecStart=/usr/local/sbin/r2-guard --job {{ pbs_offsite.sync_job }} --warn-gb {{ pbs_offsite.warn_gb }} --stop-gb {{ pbs_offsite.stop_gb }} --stop-class-a {{ pbs_offsite.stop_class_a }} --stop-class-b {{ pbs_offsite.stop_class_b }}
