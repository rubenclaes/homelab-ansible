#!/usr/bin/env python3
# {{ ansible_managed }}
#
# r2-guard: houdt Cloudflare R2 binnen de gratis laag.
#
# Vraagt aan de Cloudflare-API hoeveel er in R2 staat en hoeveel
# operaties er deze maand waren. Boven de stop-drempel, of als de vraag
# mislukt, haalt hij het schema van de sync job weg: dan schrijft PBS niets
# meer naar R2 tot iemand hem met de hand weer aanzet. Twijfel = stop.
#
# Alleen onze PBS schrijft in de bucket (het token werkt alleen daarvoor),
# dus een stop hier is een stop op alle kosten.
import argparse, datetime, json, os, subprocess, sys, urllib.request

p = argparse.ArgumentParser()
p.add_argument("--warn-gb", type=float, required=True)
p.add_argument("--stop-gb", type=float, required=True)
p.add_argument("--stop-class-a", type=int, required=True)
p.add_argument("--stop-class-b", type=int, required=True)
p.add_argument("--job", required=True)
p.add_argument("--dry-run", action="store_true", help="niets stoppen, alleen melden wat hij zou doen")
a = p.parse_args()

env = dict(l.rstrip("\n").split("=", 1) for l in open("/etc/r2-guard/env") if "=" in l)
STATE = "/var/lib/r2-guard/stopped"

# Gratis: deletes en aborts. Class B: lezen. Alles wat hier niet staat,
# telt als Class A, de dure: een nieuwe soort operatie mag nooit gratis lijken.
FREE = {"DeleteObject", "DeleteObjects", "DeleteBucket", "AbortMultipartUpload"}
CLASS_B = {"HeadBucket", "HeadObject", "GetObject", "UsageSummary", "GetBucketEncryption",
           "GetBucketLocation", "GetBucketCors", "GetBucketLifecycleConfiguration",
           "GetBucketSippyConfiguration", "GetBucket"}


def ntfy(title, msg, prio):
    req = urllib.request.Request(env["NTFY_URL"], data=msg.encode(), method="POST", headers={
        "Authorization": "Bearer " + env["NTFY_TOKEN"], "Title": title, "Priority": prio, "Tags": "cloud"})
    try:
        urllib.request.urlopen(req, timeout=15).read()
    except Exception as e:  # een melding die niet aankomt, mag de stop niet tegenhouden
        print("ntfy mislukt:", e, file=sys.stderr)


def stop(reason):
    print("STOP:", reason)
    if a.dry_run:
        return 2
    if not os.path.exists(STATE):
        cur = json.loads(subprocess.check_output(
            ["proxmox-backup-manager", "sync-job", "list", "--output-format", "json"]))
        job = next((j for j in cur if j["id"] == a.job), None)
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, "w") as f:
            f.write((job or {}).get("schedule", "") + "\n" + reason + "\n")
        if job and job.get("schedule"):
            subprocess.check_call(["proxmox-backup-manager", "sync-job", "update", a.job, "--delete", "schedule"])
    ntfy("R2-sync gestopt", reason + "\n\nPBS schrijft niets meer naar R2. Kijk het na en zet de sync "
         "met de hand weer aan (runbook: Herstellen van buiten het huis).", "high")
    return 2


def query():
    today = datetime.date.today()
    first = today.replace(day=1)
    q = """query($a: String!, $s: Date!, $e: Date!, $y: Date!) { viewer { accounts(filter: {accountTag: $a}) {
      storage: r2StorageAdaptiveGroups(limit: 100, filter: {date_geq: $y, date_leq: $e}, orderBy: [date_DESC]) {
        max { payloadSize metadataSize } dimensions { bucketName date } }
      ops: r2OperationsAdaptiveGroups(limit: 1000, filter: {date_geq: $s, date_leq: $e}) {
        sum { requests } dimensions { actionType } } } } }"""
    body = json.dumps({"query": q, "variables": {"a": env["CF_ACCOUNT"], "s": str(first), "e": str(today),
                                                 "y": str(today - datetime.timedelta(days=2))}}).encode()
    req = urllib.request.Request("https://api.cloudflare.com/client/v4/graphql", data=body, method="POST",
                                 headers={"Authorization": "Bearer " + env["CF_TOKEN"], "Content-Type": "application/json"})
    r = json.loads(urllib.request.urlopen(req, timeout=30).read())
    if r.get("errors"):
        raise RuntimeError("Cloudflare gaf fouten: %s" % r["errors"])
    acc = r["data"]["viewer"]["accounts"][0]
    # Per bucket de meest recente dag, dan optellen over alle buckets: de
    # gratis laag geldt per account, niet per bucket.
    latest = {}
    for g in acc["storage"]:
        b, d = g["dimensions"]["bucketName"], g["dimensions"]["date"]
        if b not in latest or d > latest[b][0]:
            latest[b] = (d, g["max"]["payloadSize"] + g["max"]["metadataSize"])
    gb = sum(v[1] for v in latest.values()) / 1e9
    ca = cb = 0
    for g in acc["ops"]:
        t, n = g["dimensions"]["actionType"], g["sum"]["requests"]
        if t in FREE:
            continue
        if t in CLASS_B:
            cb += n
        else:
            ca += n
    return gb, ca, cb


if os.path.exists(STATE):
    print("al gestopt:", open(STATE).read().strip().replace("\n", " | "))
    ntfy("R2-sync staat nog stil", "Sinds de vorige melding niet weer aangezet.", "default")
    sys.exit(2)

try:
    gb, ca, cb = query()
except Exception as e:
    sys.exit(stop("R2-check mislukt, dus uit voorzorg gestopt: %s" % e))

line = "R2: %.2f GB, Class A %d, Class B %d deze maand" % (gb, ca, cb)
print(line)
if gb > a.stop_gb or ca > a.stop_class_a or cb > a.stop_class_b:
    sys.exit(stop("%s. Drempel: %.0f GB / %d A / %d B." % (line, a.stop_gb, a.stop_class_a, a.stop_class_b)))
if gb >= a.warn_gb:
    ntfy("R2 bijna vol", "%s. Waarschuwing vanaf %.0f GB, stop bij %.0f GB." % (line, a.warn_gb, a.stop_gb), "default")
