# Managed by Ansible (dotfiles role), generated from the inventory
# Don't edit by hand; add hosts to the inventory instead.
{% for host in groups['linux'] | sort %}

Host {{ host }}
    HostName {{ hostvars[host].ansible_host }}
    User ansible
    IdentityFile ~/.ssh/ansible_ed25519
{% endfor %}
{% for host in groups['macs'] | sort if hostvars[host].ansible_host is defined %}

# A Mac: its own user, but the same ansible key
Host {{ host }}
    HostName {{ hostvars[host].ansible_host }}
    User {{ hostvars[host].ansible_user }}
    IdentityFile ~/.ssh/ansible_ed25519
{% endfor %}
