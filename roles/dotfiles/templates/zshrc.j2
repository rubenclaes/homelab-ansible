# Managed by Ansible (dotfiles role): edit roles/dotfiles/templates/zshrc.j2, not ~/.zshrc

# The brew packages used here (pure, fzf, nvm, zsh-*) come from the macos role.
BREW=/opt/homebrew

# 1. Paths. -U drops the duplicates a nested shell would add.
typeset -U path fpath
path=($BREW/bin /usr/local/bin $HOME/.local/bin $path $HOME/.lmstudio/bin)
# Before Oh My Zsh: its compinit picks up the brew completions (gh, tofu, ...)
fpath=($BREW/share/zsh/site-functions $fpath)

# 2. Oh My Zsh: history, completion and its default aliases. No theme: pure.
# The docker plugin writes docker's completion; OrbStack has none of its own.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(docker)
[[ -f $ZSH/oh-my-zsh.sh ]] && source $ZSH/oh-my-zsh.sh

# History, on top of what Oh My Zsh sets (share between tabs, skip lines that
# start with a space). HISTSIZE above SAVEHIST leaves room to drop duplicates.
HISTSIZE=110000
SAVEHIST=100000
setopt hist_ignore_all_dups hist_find_no_dups hist_reduce_blanks

# eza's icons need a Nerd Font in iTerm (dotfiles_iterm_profile)
if (( $+commands[eza] )); then
  alias ls='eza --icons --group-directories-first'
  alias ll='ls -l --git'
  alias la='ll -a'
fi
if (( $+commands[bat] )); then
  alias cat='bat'
  # man pages in color; MANROFFOPT keeps macOS man from writing its own escapes
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT="-c"
fi

# 3. Prompt
autoload -U promptinit && promptinit
[[ -f $BREW/share/zsh/site-functions/prompt_pure_setup ]] && prompt pure

# 4. Node. Loading nvm costs 300 ms per shell, so it loads on first use; until
# then the newest installed node is on PATH.
export NVM_DIR="$HOME/.nvm"
_node=($NVM_DIR/versions/node/*(/NnOn[1]))
path=(${_node:+$_node/bin} $path); unset _node
nvm() { unfunction nvm; source $BREW/opt/nvm/nvm.sh; nvm "$@"; }

# 5. fzf: Ctrl-R history, Ctrl-T files, Alt-C cd. Autosuggestions: grey hint
# from history, right arrow takes it.
# Files via ripgrep: skips .git and whatever .gitignore lists.
export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
export FZF_CTRL_T_COMMAND=$FZF_DEFAULT_COMMAND
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons --color=always {}'"
(( $+commands[fzf] )) && source <(fzf --zsh)
[[ -f $BREW/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source $BREW/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# 6. Homelab helpers: hl, ap (playbook menu), iTerm colors per host
[[ -f ~/.config/homelab/homelab.zsh ]] && source ~/.config/homelab/homelab.zsh

# BEGIN ANSIBLE MANAGED (dotfiles role)
{{ dotfiles_zsh_block | trim }}
# END ANSIBLE MANAGED (dotfiles role)

# Last, as its README asks: it wraps every widget defined before it.
[[ -f $BREW/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source $BREW/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh