# Managed by Ansible (dotfiles role): edit roles/dotfiles/templates/zshrc.j2, not ~/.zshrc

# 1. Environment & Paths
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
export ZSH="$HOME/.oh-my-zsh"

# 2. Source Oh My Zsh (if installed)
if [ -f "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# 3. Zplug Initialization
export ZPLUG_HOME="$(brew --prefix)/opt/zplug"
if [ -f "$ZPLUG_HOME/init.zsh" ]; then
    source "$ZPLUG_HOME/init.zsh"
fi

# 4. Zplug Plugins (Fixed & Cleaned)
zplug "mafredri/zsh-async", from:github
zplug "sindresorhus/pure", use:pure.zsh, from:github, as:theme

# Load plugins; if not installed, Zplug will ask to install them
if ! zplug check; then
    zplug install
fi
zplug load

# 5. NVM (Homebrew Version - The correct way)
export NVM_DIR="$HOME/.nvm"
[ -s "$(brew --prefix)/opt/nvm/nvm.sh" ] && \. "$(brew --prefix)/opt/nvm/nvm.sh"
[ -s "$(brew --prefix)/opt/nvm/etc/bash_completion.d/nvm" ] && \. "$(brew --prefix)/opt/nvm/etc/bash_completion.d/nvm"

# 6. Docker Completions (Standard Homebrew Path)
if [ -d "$(brew --prefix)/share/zsh/site-functions" ]; then
    fpath=($(brew --prefix)/share/zsh/site-functions $fpath)
fi

# 7. LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"

# 8. AsyncAPI CLI Autocomplete
ASYNCAPI_AC_ZSH_SETUP_PATH=$HOME/Library/Caches/@asyncapi/cli/autocomplete/zsh_setup && test -f $ASYNCAPI_AC_ZSH_SETUP_PATH && source $ASYNCAPI_AC_ZSH_SETUP_PATH

# 9. Homelab helpers: ap (playbook menu), iTerm colors per host
[ -f ~/.config/homelab/homelab.zsh ] && source ~/.config/homelab/homelab.zsh

# BEGIN ANSIBLE MANAGED (dotfiles role)
{{ dotfiles_zsh_block | trim }}
# END ANSIBLE MANAGED (dotfiles role)