# Managed by Ansible (dotfiles role): edit roles/dotfiles/templates/homelab.zsh.j2
# Sourced from ~/.zshrc. Homelab helpers for the workstation. Hosts, routes and
# Docker hosts below come from the inventory; rerun dotfiles.yml after a change.
#
#   hl                 cd to the repo
#   hl go [naam]       open a service in the browser
#   hl ssh [naam]      ssh to a host
#   hl logs [naam]     follow the logs of a container
#   hl yt [audio] [link]  send a video to MeTube; no link = the clipboard
#   hl vault [naam]    edit a vaulted file
#   hl status          firing alerts, late backups, the fullest disks
#   hl new             a new Docker service: asks, then runs new-service.yml
#   hl check           what CI checks, before you push
#   hl sandbox [--keep]  a throwaway Debian on pve01; gone when you exit
#   hl sandbox ls | rm <id>
#   ap                 pick a playbook;  ap playbooks/x.yml ...  run one
#
# Every menu takes an optional filter; with exactly one match it skips the menu.

HOMELAB_REPO="{{ dotfiles_homelab_repo | regex_replace('^~', '$HOME') }}"
{% set mac_hosts = groups['macs'] | sort | select('in', groups['all']) | list %}
{% set ssh_hosts = (groups['linux'] | sort) + (mac_hosts | map('extract', hostvars) | selectattr('ansible_host', 'defined') | map(attribute='inventory_hostname') | list) %}

# --- Inventory data -----------------------------------------------------------
typeset -A HOMELAB_HOST_IP HOMELAB_HOST_RGB HOMELAB_DOCKER_CLI
HOMELAB_HOST_IP=(
{% for h in ssh_hosts %}
  {{ h }} {{ hostvars[h].ansible_host }}
{% endfor %}
)
HOMELAB_HOST_RGB=(
{% for color, hosts in dotfiles_host_colors | dictsort %}
{% for h in hosts %}
  {{ h }} "{{ dotfiles_color_rgb[color] }}"
{% endfor %}
{% endfor %}
)
# How to reach Docker on each host that runs stacks. The ansible user is not in
# the docker group on Linux, but has sudo without a password.
HOMELAB_DOCKER_CLI=(
{% for h in groups['all'] | sort if hostvars[h].docker_stacks_list is defined %}
  {{ h }} "{{ 'sudo -n docker' if h in groups['linux'] else hostvars[h].docker_stacks_docker_cli | default('docker') }}"
{% endfor %}
)
# name <tab> host <tab> url <tab> description, one per caddy_sites route
HOMELAB_ROUTES=(
{% for s in hostvars['caddy'].caddy_sites | default([]) | sort(attribute='name') %}
  '{{ s.name }}	{{ s.host }}	https://{{ s.name }}.{{ hostvars['caddy'].caddy_domain }}	{{ s.desc | default('') | replace("'", "'\\''") }}'
{% endfor %}
)
HOMELAB_DOMAIN={{ hostvars['caddy'].caddy_domain }}
{% set prom = hostvars['caddy'].caddy_sites | default([]) | selectattr('name', 'equalto', 'prometheus') | list %}
{% if prom %}
# Prometheus for `hl status`: its own port on the LAN. The route wants a
# browser login; the port does not, and only answers reads.
HOMELAB_PROMETHEUS=http://{{ hostvars[prom[0].host].ansible_host }}:{{ prom[0].port }}
{% endif %}
{% set pbs_store = hostvars['pbs'].pbs_datastores | default([]) | selectattr('name', 'equalto', report_pbs_datastore) | list %}
{% if pbs_store %}
# PBS for `hl status`: host, datastore folder, hours before a backup is late
HOMELAB_PBS=(pbs {{ pbs_store[0].path }} {{ backup_daily_max_hours }})
# What should be in PBS: backup group -> name. Guests the daily job skips on
# purpose (report_backup_exclude) are left out, as in report.yml.
typeset -A HOMELAB_BACKUPS
HOMELAB_BACKUPS=(
{% for kind, group in [('ct', 'proxmox_all_lxc'), ('vm', 'proxmox_all_qemu')] %}
{% for h in groups.get(group, []) | sort if hostvars[h].proxmox_vmid is defined and (hostvars[h].proxmox_vmid | int) not in report_backup_exclude %}
  {{ kind }}/{{ hostvars[h].proxmox_vmid }} {{ h }}
{% endfor %}
{% endfor %}
{% for id in backup_pbs_hosts | sort %}
  host/{{ id }} {{ id }}
{% endfor %}
)
{% endif %}
{% set metube = hostvars['caddy'].caddy_sites | default([]) | selectattr('name', 'equalto', 'metube') | list %}
{% if metube %}
# MeTube for `hl yt`: host, address of its port, public url
HOMELAB_METUBE=({{ metube[0].host }} {{ hostvars[metube[0].host].ansible_host }}:{{ metube[0].port }} https://metube.{{ hostvars['caddy'].caddy_domain }})
{% endif %}

# --- Colors -------------------------------------------------------------------
# The color says how much breaks if you type in the wrong window:
{% for color, hosts in dotfiles_host_colors | dictsort %}
#   {{ color }}: {{ hosts | join(', ') }}
{% endfor %}
_homelab_fg() {  # print $2 in the color of host $1 (plain if it has none)
  local rgb=(${=HOMELAB_HOST_RGB[$1]})
  if (( $#rgb )); then
    printf '\e[38;2;%s;%s;%sm%s\e[0m' $rgb[1] $rgb[2] $rgb[3] "$2"
  else
    printf '%s' "$2"
  fi
}

_homelab_tab() {  # _homelab_tab <host> | _homelab_tab reset
  [[ $TERM_PROGRAM == iTerm.app ]] || return 0
  if [[ $1 == reset ]]; then
    printf '\e]6;1;bg;*;default\a\e]1337;SetBadgeFormat=\a'
    return
  fi
  local rgb=(${=HOMELAB_HOST_RGB[$1]})
  if (( $#rgb )); then
    printf '\e]6;1;bg;red;brightness;%s\a' $rgb[1]
    printf '\e]6;1;bg;green;brightness;%s\a' $rgb[2]
    printf '\e]6;1;bg;blue;brightness;%s\a' $rgb[3]
  fi
  printf '\e]1337;SetBadgeFormat=%s\a' "$(printf '%s' "$1" | base64)"
}

# --- ssh: iTerm tab color and badge per host ------------------------------------
# Only in iTerm; anywhere else this is plain ssh.
ssh() {
  # The host is the first argument that is not an option, and not the value
  # of one: in `ssh -o BatchMode=yes pve01` the host is pve01.
  local host arg skip=0
  for arg in "$@"; do
    if (( skip )); then skip=0; continue; fi
    case $arg in
      -[BbcDEeFIiJLlmOoPpQRSWw]) skip=1 ;;
      -*) ;;
      *) host=${arg#*@}; break ;;
    esac
  done
  _homelab_tab "$host"
  command ssh "$@"
  local rc=$?
  _homelab_tab reset
  return $rc
}

_homelab_fzf() {  # fzf with the shared look; extra flags pass through
  fzf --ansi --height=80% --layout=reverse --select-1 --exit-0 \
    --delimiter=$'\t' "$@"
}

# --- ap: ansible-playbook, from anywhere, with a menu -------------------------
# The menu does not run anything. It puts `ap playbooks/<pick>.yml ` on your
# command line, so you can add --check, --limit or -e before pressing Enter.
# Some playbooks reboot or destroy; one Enter too many should not do that.
ap() {
  if [[ $# -gt 0 ]]; then
    (cd "$HOMELAB_REPO" && ansible-playbook "$@")
    return
  fi
  local f line pick
  pick=$(cd "$HOMELAB_REPO" && for f in playbooks/*.yml; do
      # name <tab> first line of the header comment
      line=$(sed -n '2{s/^# *//;p;}' $f)
      printf '%s\t\e[2m%s\e[0m\n' $f "$line"
    done | _homelab_fzf --prompt='playbook> ' --no-select-1 \
      --preview "sed -n '2,/^[^#]/p' {1} | sed '\$d' | cut -c3-" \
      --preview-window=right,60%,wrap) || return
  print -z "ap ${pick%%$'\t'*} "
}

# Tab completion: playbook names first, host names after --limit / -l.
_ap() {
  if [[ ${words[CURRENT-1]} == (--limit|-l) ]]; then
    compadd -- ${(k)HOMELAB_HOST_IP}
  elif (( CURRENT == 2 )); then
    local pbs=($HOMELAB_REPO/playbooks/*.yml(N))
    compadd -- ${pbs#$HOMELAB_REPO/}
  else
    _files
  fi
}
(( $+functions[compdef] )) && compdef _ap ap

# --- hl -------------------------------------------------------------------------
hl() {
  local cmd=$1; (( $# )) && shift
  case $cmd in
    "")   cd "$HOMELAB_REPO" ;;
    go)   _hl_go "$@" ;;
    ssh)  _hl_ssh "$@" ;;
    logs) _hl_logs "$@" ;;
    yt)   _hl_yt "$@" ;;
    vault) _hl_vault "$@" ;;
    status) _hl_status ;;
    new)  _hl_new ;;
    check) _hl_check ;;
    sandbox) _hl_sandbox "$@" ;;
    *)    print "hl [go|ssh|logs|yt|vault|status|new|check|sandbox]  -  zie ~/.config/homelab/homelab.zsh" >&2
          return 1 ;;
  esac
}

_hl_go() {  # open a route in the browser
  local r name host url desc pick
  pick=$(for r in $HOMELAB_ROUTES; do
      IFS=$'\t' read -r name host url desc <<< "$r"
      printf '%s\t%s\t\e[2m%s\e[0m\t%s\n' "$name" "$(_homelab_fg $host $host)" "$desc" "$url"
    done | _homelab_fzf --prompt='open> ' --query="$*" --with-nth=1,2,3 \
      --preview='echo {4}' --preview-window=down,1) || return
  open "${pick##*$'\t'}"
}

_hl_ssh() {  # pick a host, in its color
  local h pick
  pick=$(for h in ${(ko)HOMELAB_HOST_IP}; do
      printf '%s\t\e[2m%s\e[0m\t%s\n' "$(_homelab_fg $h $h)" $HOMELAB_HOST_IP[$h] $h
    done | _homelab_fzf --prompt='ssh> ' --query="$*" --with-nth=1,2) || return
  ssh "${pick##*$'\t'}"
}

_hl_logs() {  # pick a container on any Docker host, follow its logs
  local tmp h pick fields
  tmp=$(mktemp -d)
  # Ask every Docker host at once; a host that does not answer in 5s is skipped.
  # Per line: name, host (colored), status, then host and docker command for
  # the preview and the follow - shown columns are only the first three.
  for h in ${(k)HOMELAB_DOCKER_CLI}; do
    command ssh -o BatchMode=yes -o ConnectTimeout=5 $h \
      "$HOMELAB_DOCKER_CLI[$h] ps --format '{{ '{{' }}.Names{{ '}}' }}\t{{ '{{' }}.Status{{ '}}' }}'" 2>/dev/null \
      | while IFS=$'\t' read -r name st; do
          printf '%s\t%s\t\e[2m%s\e[0m\t%s\t%s\n' "$name" "$(_homelab_fg $h $h)" "$st" $h "$HOMELAB_DOCKER_CLI[$h]"
        done > $tmp/$h &
  done
  wait
  pick=$(cat $tmp/*(N) | sort | _homelab_fzf --prompt='logs> ' --query="$*" \
    --with-nth=1,2,3 --preview-window=down,50%,follow \
    --preview 'command ssh -o BatchMode=yes {4} {5} logs --tail 40 {1} 2>&1')
  rm -rf $tmp
  [[ -n $pick ]] || return
  fields=("${(@ps:\t:)pick}")
  print "Logs van $fields[1] op $fields[4] - Ctrl-C om te stoppen"
  ssh -t $fields[4] "$fields[5] logs -f --tail 200 $fields[1]"
}

_hl_yt() {  # send a link to MeTube; without one, use the clipboard
  local type=video format=any url reply
  if [[ $1 == audio ]]; then type=audio format=mp3; shift; fi
  url=${1:-$(pbpaste 2>/dev/null)}
  if [[ $url != http*://* ]]; then
    print "hl yt [audio] <link>  -  of kopieer eerst een link" >&2
    return 1
  fi
  (( $+HOMELAB_METUBE )) || { print "MeTube staat niet in caddy_sites" >&2; return 1; }
  # Via ssh, not via https: MeTube's port only answers Caddy, and Caddy wants
  # a browser login. On the host itself neither applies.
  reply=$(jq -nc --arg url $url --arg type $type --arg format $format \
      '{url: $url, download_type: $type, format: $format, quality: "best"}' \
    | command ssh -o BatchMode=yes -o ConnectTimeout=5 $HOMELAB_METUBE[1] \
      "curl -s -m 30 -H 'Content-Type: application/json' --data-binary @- http://$HOMELAB_METUBE[2]/add") \
    || { print "MeTube niet bereikbaar via $HOMELAB_METUBE[1]" >&2; return 1; }
  if [[ $(jq -r .status <<< $reply 2>/dev/null) == ok ]]; then
    print "In de wachtrij ($type). Volg op $HOMELAB_METUBE[3]"
  else
    print "MeTube weigert: $reply" >&2
    return 1
  fi
}

_hl_vault() {  # pick a vaulted file and edit it; ansible-vault keeps its vault id
  local f pick
  pick=$(cd "$HOMELAB_REPO" && git grep -l -e '^\$ANSIBLE_VAULT' | while read -r f; do
      printf '%s\t\e[2m%s\e[0m\n' $f "$(head -1 $f | cut -d';' -f4)"
    done | _homelab_fzf --prompt='vault> ' --query="$*") || return
  (cd "$HOMELAB_REPO" && ansible-vault edit "${pick%%$'\t'*}")
}

_hl_status() {  # firing alerts, late backups and the fullest disks, on one screen
  local tmp sev what age i m p g h late=()
  local -A seen
  tmp=$(mktemp -d)
  # All three at once; whatever does not answer within 5s says so below.
  if (( $+HOMELAB_PROMETHEUS )); then
    curl -sf -m 5 $HOMELAB_PROMETHEUS/api/v1/alerts > $tmp/alerts &
    curl -sf -m 5 -G $HOMELAB_PROMETHEUS/api/v1/query --data-urlencode \
      'query=topk(10, 100 * (1 - node_filesystem_avail_bytes{fstype!~"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*", mountpoint!~"/System/Volumes/.*"} / node_filesystem_size_bytes) unless node_filesystem_readonly == 1)' \
      > $tmp/disks &
  fi
  # Straight from the datastore folder: <type>/<id>/<time of each backup>.
  # Reads no API, so it needs no token; the age is counted on PBS itself.
  if (( $+HOMELAB_PBS )); then
    command ssh -o BatchMode=yes -o ConnectTimeout=5 $HOMELAB_PBS[1] \
      sudo -n sh -s $HOMELAB_PBS[2] > $tmp/pbs 2>/dev/null <<'EOF' &
cd "$1" || exit 1
now=$(date +%s)
for g in ct/* vm/* host/*; do
  s=$(ls -1 "$g" 2>/dev/null | grep '^[0-9]' | tail -n 1)
  [ -n "$s" ] && echo "$g $(( (now - $(date -d "$s" +%s)) / 3600 ))"
done
EOF
  fi
  wait

  print '\e[1mAlarmen\e[0m'
  if [[ ! -s $tmp/alerts ]]; then
    print "  \e[33mPrometheus antwoordt niet ($HOMELAB_PROMETHEUS)\e[0m"
  else
    # One line per problem: two volumes of one APFS container share their
    # free space, so their disk alarms have the same alert, host and value. Critical first, then the oldest.
    jq -r '[.data.alerts[] | select(.state == "firing")
        | {sev: .labels.severity, key: [.labels.alertname, .labels.instance, .value], what: (.annotations.summary // .labels.alertname),
           h: ((now - (.activeAt | sub("\\.[0-9]+"; "") | fromdateiso8601)) / 3600 | floor)}]
      | unique_by(.key) | sort_by((.sev != "critical"), -.h) | .[]
      | [.sev, .what, (if .h < 48 then "\(.h)u" else "\(.h / 24 | floor)d" end)] | @tsv' \
      $tmp/alerts > $tmp/alerts.tsv
    if [[ ! -s $tmp/alerts.tsv ]]; then
      print '  \e[32m✓ geen\e[0m'
    fi
    while IFS=$'\t' read -r sev what age; do
      if [[ $sev == critical ]]; then
        printf '  \e[31m✗ %s\e[0m \e[2msinds %s\e[0m\n' "$what" $age
      else
        printf '  \e[33m! %s\e[0m \e[2msinds %s\e[0m\n' "$what" $age
      fi
    done < $tmp/alerts.tsv
  fi

  print '\n\e[1mBack-ups\e[0m'
  if [[ ! -s $tmp/pbs ]]; then
    print "  \e[33mPBS antwoordt niet ($HOMELAB_PBS[1])\e[0m"
  else
    while read -r g h; do seen[$g]=$h; done < $tmp/pbs
    for g in ${(ko)HOMELAB_BACKUPS}; do
      if (( ! $+seen[$g] )); then
        late+=("$HOMELAB_BACKUPS[$g] ($g): geen back-up")
      elif (( $seen[$g] > $HOMELAB_PBS[3] )); then
        late+=("$HOMELAB_BACKUPS[$g] ($g): $seen[$g]u geleden")
      fi
    done
    if (( $#late )); then
      printf '  \e[31m✗ %s\e[0m\n' $late
    else
      print "  \e[32m✓ alle $#HOMELAB_BACKUPS jonger dan $HOMELAB_PBS[3]u\e[0m"
    fi
  fi

  print '\n\e[1mVolste schijven\e[0m'
  if [[ ! -s $tmp/disks ]]; then
    print "  \e[33mPrometheus antwoordt niet\e[0m"
  else
    jq -r '[.data.result[] | {i: .metric.instance, m: .metric.mountpoint, p: (.value[1] | tonumber | floor)}]
      | unique_by([.i, .p]) | sort_by(-.p) | .[:5][] | [.i, .m, .p] | @tsv' $tmp/disks \
    | while IFS=$'\t' read -r i m p; do
        printf '  %s %-28s ' "$(_homelab_fg $i "$(printf '%-22s' $i)")" $m
        if (( p >= 90 )); then printf '\e[31m%3s%%\e[0m\n' $p
        elif (( p >= 80 )); then printf '\e[33m%3s%%\e[0m\n' $p
        else printf '%3s%%\n' $p
        fi
      done
  fi
  rm -rf $tmp
}

_hl_new() {  # a new Docker service: asks the values, then runs new-service.yml
  local name image port volume=/data desc auth=admin host=docker ok json
  print "Nieuwe Docker-dienst. Enter neemt wat er al staat."
  vared -p 'naam, ook het adres: ' name || return
  [[ $name =~ '^[a-z0-9-]+$' ]] || { print "alleen kleine letters, cijfers en -" >&2; return 1; }
  vared -p 'image met versie: ' image || return
  # No tag means latest, and latest updates behind Renovate's back.
  if [[ ${image##*/} != *[:@]* || $image == *:latest ]]; then
    print "neem een vaste versie, bv. ghcr.io/usememos/memos:0.24.4" >&2; return 1
  fi
  vared -p 'poort: ' port || return
  [[ $port =~ '^[0-9]+$' ]] || { print "de poort is een getal" >&2; return 1; }
  vared -p 'datamap in de container: ' volume || return
  vared -p 'omschrijving: ' desc || return
  vared -p 'login via Pocket ID (admin, gezin, gezin,gast; leeg = de app doet het zelf): ' auth || return
  vared -p "host (${(ko)HOMELAB_DOCKER_CLI}): " host || return
  (( $+HOMELAB_DOCKER_CLI[$host] )) || { print "$host draait geen stacks" >&2; return 1; }

  print "\nhttps://$name.$HOMELAB_DOMAIN -> $host:$port, $image, login: ${auth:-van de app}"
  read -k1 "ok?Aanmaken? [j/N] "; print
  [[ $ok == [jJyY] ]] || return 1
  # As JSON: -e key=value cuts a value at its first space (see new-service.yml).
  json=$(jq -nc --arg n $name --arg i $image --arg p $port --arg v $volume \
      --arg d "$desc" --arg a "$auth" --arg h $host \
    '{svc_name: $n, svc_image: $i, svc_port: ($p | tonumber), svc_volume: $v,
      svc_desc: $d, svc_auth: $a, svc_host: $h} | if $d == "" then del(.svc_desc) else . end')
  ap playbooks/new-service.yml -e "$json"
}

_hl_step() {  # _hl_step <label> <command...>: ok, or FOUT plus the end of the output
  local label=$1 out; shift
  printf '%-14s' $label
  if out=$("$@" 2>&1); then
    print '\e[32mok\e[0m'
  else
    print '\e[31mFOUT\e[0m'
    print -r -- $out | tail -n 25 | sed 's/^/    /'
    return 1
  fi
}

_hl_check() {  # the checks of .github/workflows/lint.yml, before you push
  (
    cd "$HOMELAB_REPO" || exit 1
    local rc=0
    _hl_step versleuteld bin/check-vaulted || rc=1
    _hl_step ansible-lint ansible-lint || rc=1
    _hl_step syntax ansible-playbook --syntax-check playbooks/*.yml || rc=1
    if (( $+commands[tofu] )); then
      _hl_step 'tofu fmt' tofu fmt -check -recursive tofu || rc=1
    fi
    exit $rc
  )
}

_hl_sandbox() {  # a throwaway container on pve01, gone again when you exit
  local keep=0 out id ip
  case $1 in
    ls) command ssh -o BatchMode=yes pve01 sudo -n sandbox ls; return ;;
    rm) command ssh -o BatchMode=yes pve01 sudo -n sandbox rm "$2"; return ;;
    --keep) keep=1 ;;
    "") ;;
    *) print "hl sandbox [--keep | ls | rm <id>]" >&2; return 1 ;;
  esac
  print "Sandbox maken op pve01..."
  out=$(command ssh -o BatchMode=yes pve01 sudo -n sandbox new) || return 1
  read -r id ip <<< $out
  # Every sandbox is a new host key, often on an address an earlier one had:
  # known_hosts would only get in the way.
  print "sandbox $id op $ip. Over ssh, vanuit een ander venster:"
  print "  ssh -i ~/.ssh/ansible_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@$ip"
  print "Je zit erin als root. exit = $( (( keep )) && print 'stoppen, hij blijft staan' || print 'weg ermee')."
  _homelab_tab sandbox-$id
  command ssh -t pve01 sudo -n pct enter $id
  _homelab_tab reset
  if (( keep )); then
    print "sandbox $id blijft staan, tot de opruimjob hem na een dag weghaalt. Nu al weg: hl sandbox rm $id"
  else
    command ssh -o BatchMode=yes pve01 sudo -n sandbox rm $id
  fi
}
