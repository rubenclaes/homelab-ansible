#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Wegwerp-containers, voor `hl sandbox` op de laptop. Werkt ook hier:
#
#   sandbox new        maakt er een en start hem; print "<id> <ip>"
#   sandbox ls         welke er zijn, en hoe oud
#   sandbox rm <id>    weg ermee
#   sandbox prune      weg met alles ouder dan {{ proxmox_host_sandbox_max_age_hours }} uur (de timer, elk uur)
#
# Een sandbox heeft een nummer uit {{ proxmox_host_sandbox_vmid_first }}-{{ proxmox_host_sandbox_vmid_last }} EN het label `sandbox`.
# rm en prune controleren allebei voor ze iets weggooien: een verkeerd nummer
# mag nooit een echte guest raken. Het label houdt hem ook uit de inventory.
set -euo pipefail

first={{ proxmox_host_sandbox_vmid_first }}
last={{ proxmox_host_sandbox_vmid_last }}

is_sandbox() {  # is_sandbox <id>: in de reeks en met het label
	local id=$1
	[[ $id =~ ^[0-9]+$ ]] && ((id >= first && id <= last)) || return 1
	grep -Eq '^tags: (.*;)?sandbox(;.*)?$' "/etc/pve/lxc/$id.conf" 2>/dev/null
}

age_of() {  # age_of <id>: seconden sinds de config geschreven werd
	echo $(($(date +%s) - $(stat -c %Y "/etc/pve/lxc/$1.conf")))
}

cmd_new() {
	local id ip=""
	for ((id = first; id <= last; id++)); do
		[[ -e /etc/pve/lxc/$id.conf || -e /etc/pve/qemu-server/$id.conf ]] || break
	done
	if ((id > last)); then
		echo "sandbox: geen vrij nummer meer tussen $first en $last" >&2
		exit 1
	fi

	# Klein en thin-provisioned: 8 GB is een bovengrens, geen reservering.
	# nesting=1 voor systemd in Debian 13 en voor Docker in de sandbox.
	pct create "$id" {{ proxmox_host_sandbox_template }} \
		--hostname "sandbox-$id" --tags sandbox \
		--unprivileged 1 --features nesting=1 \
		--cores 2 --memory 1024 --swap 512 \
		--rootfs {{ proxmox_host_sandbox_storage }}:{{ proxmox_host_sandbox_disk_gb }} \
		--net0 name=eth0,bridge={{ pve_guest_network.bridge }},ip=dhcp \
		--searchdomain {{ pve_guest_network.searchdomain }} \
		--ssh-public-keys {{ proxmox_host_sandbox_ssh_keys }} \
		--start 1 >/dev/null

	# DHCP duurt een paar seconden; zonder adres werkt hij nog, maar zonder net.
	for _ in $(seq 30); do
		ip=$(pct exec "$id" -- ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
		[[ -n $ip ]] && break
		sleep 1
	done
	echo "$id ${ip:--}"
}

cmd_ls() {
	local conf id
	for conf in /etc/pve/lxc/*.conf; do
		id=$(basename "$conf" .conf)
		is_sandbox "$id" || continue
		printf '%s\t%s\t%s min\n' "$id" "$(pct status "$id" | cut -d' ' -f2)" $(($(age_of "$id") / 60))
	done
}

cmd_rm() {
	local id=${1:?gebruik: sandbox rm <id>}
	if ! is_sandbox "$id"; then
		echo "sandbox: $id is geen sandbox, niets gedaan" >&2
		exit 1
	fi
	pct stop "$id" >/dev/null 2>&1 || true
	pct destroy "$id" --purge >/dev/null
	echo "sandbox $id verwijderd"
}

cmd_prune() {
	local conf id
	for conf in /etc/pve/lxc/*.conf; do
		id=$(basename "$conf" .conf)
		is_sandbox "$id" || continue
		(($(age_of "$id") > {{ proxmox_host_sandbox_max_age_hours }} * 3600)) || continue
		cmd_rm "$id"
	done
}

case ${1:-} in
	new) cmd_new ;;
	ls) cmd_ls ;;
	rm) cmd_rm "${2:-}" ;;
	prune) cmd_prune ;;
	*)
		echo "gebruik: sandbox new | ls | rm <id> | prune" >&2
		exit 2
		;;
esac
