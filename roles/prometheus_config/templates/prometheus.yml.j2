# {{ ansible_managed }}
# Bron: roles/prometheus_config in homelab-ansible. De doelen volgen uit de
# inventory-groep `{{ prometheus_config_node_group }}`.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: alertmanager
    static_configs:
      - targets: ['alertmanager:9093']

  # `instance` is de inventory-naam, niet IP:poort: zo staat er "pve01" in een
  # melding, en niet 192.168.0.10:9100. `kind` komt uit de inventory-groepen:
  # host, vm, lxc of mac. Het dashboard laat er de kleine containers mee weg
  # uit de grafieken. `tailnet` staat op de hosts uit de inventory-groep
  # tailnet: daar hoort een tailscaled.prom te zijn, en zonder dat label kan
  # een alarm niet zien dat hij ontbreekt.
  - job_name: node
    static_configs:
{% for host in (groups[prometheus_config_node_group] + prometheus_config_node_extra_hosts) | sort %}
{%   set kind = 'host' if host in groups.get('proxmox', [])
          else 'lxc' if host in groups.get('proxmox_all_lxc', [])
          else 'vm' if host in groups.get('proxmox_all_qemu', [])
          else 'mac' if host in groups.get('macs', [])
          else 'other' %}
      - targets: ['{{ hostvars[host].ansible_host }}:{{ prometheus_config_node_port }}']
        labels: { instance: {{ host }}, kind: {{ kind }}{{ ', tailnet: "true"' if host in groups.get('tailnet', []) else '' }} }
{% endfor %}
