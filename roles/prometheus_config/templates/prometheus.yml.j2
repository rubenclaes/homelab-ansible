# {{ ansible_managed }}
# Bron: roles/prometheus_config in homelab-ansible. De doelen volgen uit de
# inventory-groep `{{ prometheus_config_node_group }}`.
global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: alertmanager
    static_configs:
      - targets: ['alertmanager:9093']

  # `instance` is de inventory-naam, niet IP:poort: zo staat er "pve01" in een
  # melding, en niet 192.168.0.10:9100.
  - job_name: node
    static_configs:
{% for host in groups[prometheus_config_node_group] | sort %}
      - targets: ['{{ hostvars[host].ansible_host }}:{{ prometheus_config_node_port }}']
        labels: { instance: {{ host }} }
{% endfor %}
