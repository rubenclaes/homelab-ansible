    {
      "type": "table",
      "title": "Hosts",
      "description": "Eén regel per host. CPU en geheugen: gemiddelde over 5 minuten.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bffp6ddhc3oqoc"
          },
          "expr": "up{job=\"node\", instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bffp6ddhc3oqoc"
          },
          "expr": "100 * sum by (instance) (rate(node_cpu_seconds_total{mode!=\"idle\", instance=~\"$instance\"}[5m])) / sum by (instance) (rate(node_cpu_seconds_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bffp6ddhc3oqoc"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{instance=~\"$instance\"} / node_memory_MemTotal_bytes{instance=~\"$instance\"}) or 100 * (1 - (node_memory_free_bytes{instance=~\"$instance\"} + node_memory_inactive_bytes{instance=~\"$instance\"}) / node_memory_total_bytes{instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bffp6ddhc3oqoc"
          },
          "expr": "time() - node_boot_time_seconds{instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true
            },
            "indexByName": {
              "instance": 0,
              "kind": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
