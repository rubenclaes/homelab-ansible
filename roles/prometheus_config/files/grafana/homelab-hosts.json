    {
      "type": "table",
      "title": "Wanneer vol",
      "description": "Bij het tempo van de laatste 12 uur: over hoeveel dagen een schijf vol is. Alleen schijven die vollopen, en binnen een jaar. Leeg = niets in zicht. Een schijf die net begint te vullen tot een vaste grens (zoals de R2-cache op pbs) lijkt hier sneller vol dan hij wordt.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bffp6ddhc3oqoc"
          },
          "expr": "((node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|autofs|devfs\", mountpoint!~\"/boot/efi|/vm-hdd/(subvol|basevol)-.*|/System/Volumes/(Preboot|VM|Update.*|xarts|iSCPreboot|Hardware)\", instance=~\"$instance\"} / -deriv(node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|autofs|devfs\", mountpoint!~\"/boot/efi|/vm-hdd/(subvol|basevol)-.*|/System/Volumes/(Preboot|VM|Update.*|xarts|iSCPreboot|Hardware)\", instance=~\"$instance\"}[12h])) / 86400 > 0 < 365) and on(instance, mountpoint, device) (node_filesystem_readonly{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|autofs|devfs\", mountpoint!~\"/boot/efi|/vm-hdd/(subvol|basevol)-.*|/System/Volumes/(Preboot|VM|Update.*|xarts|iSCPreboot|Hardware)\", instance=~\"$instance\"} == 0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "device": true,
              "fstype": true
            },
            "indexByName": {
              "instance": 0,
              "mountpoint": 1,
              "Value": 2
            },
            "renameByName": {
              "instance": "Host",
              "mountpoint": "Schijf",
              "Value": "Vol over"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Vol over"
              }
            ]
          }
        }
      ],
      "options": {
