    {
      "type": "bargauge",
      "title": "Schijven: hoe vol",
      "description": "Gebruikt, per schijf, de volste bovenaan. Oranje vanaf 80%, rood vanaf 90% (het alarm gaat af onder 10% vrij). Op de Mac mini delen media01, NetworkTM en LocalTM één schijf van 8 TB. De ZFS-pool vm-hdd staat hier niet: bij ZFS telt de bovenste dataset alleen zichzelf en toont hij 0%; zijn vrije ruimte staat onderaan.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bffp6ddhc3oqoc"
          },
          "expr": "sort_desc(100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|autofs|devfs\", mountpoint!~\"/boot/efi|/vm-hdd/(subvol|basevol)-.*|/System/Volumes/(Preboot|VM|Update.*|xarts|iSCPreboot|Hardware)\", instance=~\"$instance\", mountpoint!=\"/vm-hdd\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|autofs|devfs\", mountpoint!~\"/boot/efi|/vm-hdd/(subvol|basevol)-.*|/System/Volumes/(Preboot|VM|Update.*|xarts|iSCPreboot|Hardware)\", instance=~\"$instance\", mountpoint!=\"/vm-hdd\"}) and on(instance, mountpoint, device) (node_filesystem_readonly{fstype!~\"tmpfs|ramfs|overlay|squashfs|nsfs|fuse.*|autofs|devfs\", mountpoint!~\"/boot/efi|/vm-hdd/(subvol|basevol)-.*|/System/Volumes/(Preboot|VM|Update.*|xarts|iSCPreboot|Hardware)\", instance=~\"$instance\", mountpoint!=\"/vm-hdd\"} == 0))",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "minVizHeight": 16,
        "maxVizHeight": 22,
        "namePlacement": "left",
        "sizing": "manual"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 14,
        "h": 13
      },
