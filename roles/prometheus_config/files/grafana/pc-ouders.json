      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bffp6ddhc3oqoc"
          },
          "expr": "max_over_time(timestamp(up{instance=\"pc-ouders\", job=\"integrations/windows\"})[14d:5m]) * 1000",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
